{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Service Health & Prediction Overview",
      "type": "row"
    },
    {
      "id": 1,
      "title": "Total Prediction Request Throughput (req/sec)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 1 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(rate(http_requests_total[30s])) by (endpoint)",
          "legendFormat": "{{endpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth" }
        }
      }
    },
    {
      "id": 2,
      "title": "Inference Latency Percentiles (p50, p95, p99)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 1 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{endpoint='/predict'}[30s])) by (le)) * 1000",
          "legendFormat": "p50 (median) ms"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{endpoint='/predict'}[30s])) by (le)) * 1000",
          "legendFormat": "p95 ms (SLA Limit: 150ms)"
        },
        {
          "datasource": "Prometheus",
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{endpoint='/predict'}[30s])) by (le)) * 1000",
          "legendFormat": "p99 ms"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": { "drawStyle": "line" }
        }
      }
    },
    {
      "id": 3,
      "title": "Share of Failure Predictions Over Time (%)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 1 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "tower_failure_prediction_ratio * 100",
          "legendFormat": "Failure Prediction Share %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": { "drawStyle": "line", "fillOpacity": 20 }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "id": 101,
      "title": "Errors & System Telemetry",
      "type": "row"
    },
    {
      "id": 4,
      "title": "HTTP Error Rate (%)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 9 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "(sum(rate(http_requests_total{status=~'[45]..'}[1m])) / sum(rate(http_requests_total[1m]))) * 100",
          "legendFormat": "Error Rate %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Cumulative Predictions by Classification Outcome",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 9 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "sum(tower_predictions_total) by (prediction_class)",
          "legendFormat": "{{prediction_class}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "bars", "fillOpacity": 40 }
        }
      }
    },
    {
      "id": 6,
      "title": "Service Uptime (Hours)",
      "type": "stat",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 9 },
      "targets": [
        {
          "datasource": "Prometheus",
          "expr": "service_uptime_seconds / 3600",
          "legendFormat": "Uptime"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "color": { "mode": "palette-classic" }
        }
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["mlops", "telecom", "failure-prediction"],
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m"]
  },
  "timezone": "browser",
  "title": "Telecom Tower Failure Prediction Operations Dashboard",
  "uid": "telecom-tower-ops",
  "version": 1
}
